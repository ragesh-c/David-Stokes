  <script>
  (async function () {
    const grid = document.getElementById('journal-grid');
    if (!grid) return;
    try {
      const res  = await fetch('data/journal-posts.json');
      const data = await res.json();
      const posts = (data.posts || []).sort((a, b) => new Date(b.date) - new Date(a.date));

      posts.forEach(post => {
        const card = document.createElement('a');
        card.href      = 'journal/' + post.slug + '.html';
        card.className = 'journal-card';

        card.innerHTML = `
          <div class="journal-card-image">
            <img src="${post.hero_image}" alt="${post.title}" style="object-position:${post.hero_image_position || 'center center'}" loading="lazy" decoding="async">
          </div>
          <span class="period-label" style="display:inline-block;margin-top:0.75rem;">${post.period_label}</span>
          <h3 class="journal-card-title">${post.title}</h3>
          <p class="journal-card-excerpt">${post.excerpt}</p>
        `;
        grid.appendChild(card);
      });

      // Trigger anime.js stagger once cards are in the DOM
      if (window.anime) {
        const cards = grid.querySelectorAll('.journal-card');
        window.anime.utils.set(cards, { opacity: 0, translateY: 30 });
        window.anime.animate(cards, {
          opacity: [0, 1],
          y: [30, 0],
          duration: 700,
          delay: window.anime.stagger(70),
          ease: 'out(3)',
        });
      }
    } catch (err) {
      console.error('Could not load posts:', err);
    }
  })();
  </script>
