DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # HTTP 302 redirect root / to /index.html to bypass Nginx root proxy cache completely
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /\ HTTP/ [NC]
    RewriteRule ^$ /index.html [R=302,L]

    RewriteRule ^api/posts/?$ api/index.php?action=posts [L,QSA]
    RewriteRule ^api/upload/?$ api/index.php?action=upload [L,QSA]
    RewriteRule ^api/post/(.+)$ api/index.php?action=delete&slug=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
    Header set Pragma "no-cache"
    Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    Header set X-Accel-Expires "0"
</IfModule>
